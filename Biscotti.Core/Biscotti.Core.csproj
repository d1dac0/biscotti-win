<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="NAudio" Version="3.2.0" />
    <!-- CPU-only Whisper runtime bundled by default: works on every Windows
         machine (issue #3). The opt-in GPU/CUDA tier is NOT a package ref —
         it is downloaded lazily into %LOCALAPPDATA%\BiscottiWin\runtimes by
         GpuRuntimeStore and activated via WhisperRuntimeConfigurator (#20). -->
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Biscotti.Tests" />
  </ItemGroup>

</Project>
