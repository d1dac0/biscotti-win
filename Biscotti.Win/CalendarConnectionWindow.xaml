<Window x:Class="Biscotti.Win.CalendarConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect calendars" Width="630" Height="700" MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Your meeting schedule" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose your calendar providers, then select calendars for your meeting schedule." Style="{StaticResource Hint}" Margin="0,10,0,16"/>
            <WrapPanel>
                <Button x:Name="GoogleButton" Content="Google Calendar" Tag="google" Click="AddProvider_Click" Margin="0,0,8,8"/>
                <Button x:Name="MicrosoftButton" Content="Outlook / Microsoft 365" Tag="microsoft" Click="AddProvider_Click" Margin="0,0,8,8"/>
                <Button x:Name="ICloudButton" Content="Apple iCloud" Tag="icloud" Click="AddProvider_Click" Margin="0,0,0,8"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="OutlookButton" Content="Connect classic Outlook" Click="Outlook_Click" Margin="0,0,8,8"/>
                <Button x:Name="FileButton" Content="Choose .ics file…" Click="File_Click" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="Google and Microsoft use subscription links you provide. iCloud uses an app-specific password. Live provider sync needs internet; recording and AI still run on this PC." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
            <TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="ConnectedSources" Margin="0,14"/>
                <TextBlock Text="SHOW THESE CALENDARS" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="CalendarChoices"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Timed events with a conference link or at least two invitees appear in Upcoming. Files update only when the export itself changes." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveConnectionButton" Content="Save calendars" IsEnabled="False" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
