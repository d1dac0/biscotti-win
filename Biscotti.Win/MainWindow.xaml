<Window x:Class="Biscotti.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Biscotti.Win"
        Title="Biscotti Win — private meeting notes" Height="600" Width="880"
        Background="#FAF9F6">
    <Window.Resources>
        <local:LocalStartTimeConverter x:Key="LocalStartTime"/>
        <local:MeetingDurationConverter x:Key="MeetingDuration"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🍅 Biscotti Win" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="RecordingDurationText" Foreground="#277D5E" FontSize="15"
                       FontWeight="SemiBold" Margin="0,6,0,0" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="StatusText" Foreground="#555" Margin="0,6,0,0"
                       Text="All local. Nothing leaves this PC." TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
            <Button x:Name="RecordButton" Width="180" Height="44" FontSize="16"
                    Background="#C0392B" Foreground="White" BorderThickness="0"
                    Click="RecordButton_Click" Content="●  Start recording"/>
            <Button x:Name="ModelButton" Width="200" Height="44" Margin="12,0,0,0"
                    Click="ModelButton_Click" Content="Download Whisper model"
                    Background="#EEE" BorderThickness="0"/>
            <ProgressBar x:Name="ModelProgress" Width="180" Height="14" Margin="12,0,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
            <Button x:Name="AudioDevicesButton" Height="44" Margin="12,0,0,0" Padding="16,0"
                    Content="Audio devices" Click="AudioDevicesButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Meeting app audio" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="AudioAppPicker" Width="480" Height="30" VerticalContentAlignment="Center"/>
            <Button Content="Refresh" Margin="8,0,0,0" Padding="12,4" Click="RefreshAudioApps_Click"/>
        </StackPanel>

        <TextBlock x:Name="DeviceWarningText" Grid.Row="3" Foreground="#9B2C20" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Upcoming meetings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ChooseCalendarButton" Content="Choose .ics file" Padding="12,4"
                            Click="ChooseCalendarButton_Click"/>
                    <Button x:Name="RefreshCalendarButton" Content="Refresh" Margin="8,0,0,0" Padding="12,4"
                            Click="RefreshCalendarButton_Click"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="CalendarSourceText" Foreground="#668" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock x:Name="CalendarEmptyText" Text="Choose a local .ics file to see events in the next 24 hours."
                       Foreground="#668" Margin="0,4,0,0"/>
            <ScrollViewer MaxHeight="142" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="UpcomingMeetingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" Margin="0,2" Background="#F0EEE8" CornerRadius="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Record" Padding="12,3" Margin="8,0,0,0"
                                            Tag="{Binding}" Click="RecordUpcomingMeeting_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="#668" FontSize="12"
                                                   Text="{Binding StartsAt, StringFormat={}{0:ddd, MMM d · h:mm tt}}"/>
                                        <TextBlock Foreground="#668" FontSize="11" Text="{Binding AttendeesDisplay}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <ListBox x:Name="MeetingList" Grid.Row="5" HorizontalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0"
                 MouseDoubleClick="MeetingList_DoubleClick"
                 SelectionChanged="MeetingList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Foreground="#668" FontSize="12"
                                       Text="{Binding StartedUtc, Converter={StaticResource LocalStartTime}}"/>
                            <TextBlock Foreground="#668" FontSize="12">
                                <Run Text="{Binding ., Converter={StaticResource MeetingDuration}}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Transcript.Count, Mode=OneWay, StringFormat='{}{0} lines'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
