<Window x:Class="Biscotti.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Biscotti.Win"
        Title="Biscotti Win — private meeting notes" Height="820" Width="1000" MinWidth="680" MinHeight="480" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="HistorySearch_PreviewKeyDown">
    <Window.Resources>
        <local:LocalStartTimeConverter x:Key="LocalStartTime"/>
        <local:MeetingDurationConverter x:Key="MeetingDuration"/>
    </Window.Resources>
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,28" MaxWidth="920">
        <DockPanel Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Content="_Settings" Click="SettingsButton_Click" VerticalAlignment="Top" AutomationProperties.Name="Settings"/>
            <StackPanel>
                <TextBlock Text="Biscotti" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Private meeting notes. All on this PC." Style="{StaticResource Hint}" Margin="0,8,16,0"/>
            </StackPanel>
        </DockPanel>
        <Border x:Name="PreviewBanner" Background="{DynamicResource WashBrush}" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Preview tray menu" Margin="12,0,0,0" Click="PreviewTrayMenu_Click"/>
                <TextBlock Text="DESIGN PREVIEW · Synthetic data only. No recording, downloads or saved changes." TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="RecordingHeading" Text="RECORD A MEETING" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="SetupText" Text="Start with a local transcription model" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap"/>
                <TextBlock x:Name="SetupHint" Text="Download Whisper once, then record and transcribe offline. Summaries use Ollama on this PC." Style="{StaticResource Hint}" Margin="0,8,0,16"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="RecordButton" MinWidth="180" Margin="0,0,10,8" Style="{StaticResource PrimaryButton}" Click="RecordButton_Click" Content="●  Start recording"/>
                    <Button x:Name="ModelButton" Margin="0,0,10,8" Click="ModelButton_Click" Content="Download Whisper model"/>
                    <Button x:Name="CancelModelButton" Margin="0,0,10,8" Click="CancelModel_Click" Content="Cancel download" Visibility="Collapsed"/>
                    <Button x:Name="AudioDevicesButton" Margin="0,0,0,8" Content="Audio devices" Click="AudioDevicesButton_Click"/>
                </WrapPanel>
                <ProgressBar x:Name="ModelProgress" Height="8" Margin="0,0,0,12" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Model download progress"/>
                <TextBlock x:Name="SummaryReadinessText" Text="Check local models in Settings before your first meeting." Style="{StaticResource Hint}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="ProcessingProgress" Height="8" Margin="0,0,0,12" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Local processing progress"/>
                <Label Target="{Binding ElementName=AudioAppPicker}" Content="Meeting _app audio" Padding="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh apps" Margin="10,0,0,0" Click="RefreshAudioApps_Click"/>
                    <ComboBox x:Name="AudioAppPicker" AutomationProperties.Name="Meeting app audio"/>
                </DockPanel>
                <TextBlock x:Name="RecordingDurationText" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="All local. Nothing leaves this PC." AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="DeviceWarningText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,0,0,12">
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="ChooseCalendarButton" Content="Choose .ics file" Click="ChooseCalendarButton_Click"/>
                <Button x:Name="RefreshCalendarButton" Content="Refresh" Margin="8,0,0,0" Click="RefreshCalendarButton_Click"/>
            </WrapPanel>
            <TextBlock Text="UPCOMING" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="CalendarSourceText" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="CalendarEmptyText" Text="Choose a local .ics file to see events in the next 24 hours." Style="{StaticResource Hint}"/>
                <ItemsControl x:Name="UpcomingMeetingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,4" Background="{DynamicResource WashBrush}" CornerRadius="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Record" Margin="12,0,0,0" VerticalAlignment="Center" Tag="{Binding}" Click="RecordUpcomingMeeting_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding StartsAt, StringFormat={}{0:ddd, MMM d · h:mm tt}}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding AttendeesDisplay}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <TextBlock Text="MEETING HISTORY" Style="{StaticResource SectionTitle}"/>
        <Border x:Name="HistoryCard" Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <Label Target="{Binding ElementName=SearchBox}" Content="_Search meetings (Ctrl+F)"/>
                <WrapPanel Margin="8,0,8,8">
                    <Button x:Name="ImportCsvButton" Content="Import CSV…" Click="ImportCsv_Click" Margin="0,0,8,4"/>
                    <Button x:Name="ExportCsvButton" Content="Export all to CSV…" Click="ExportCsv_Click" Margin="0,0,8,4"/>
                    <Button x:Name="CancelTransferButton" Content="Cancel transfer" Click="CancelTransfer_Click" Visibility="Collapsed"/>
                </WrapPanel>
                <TextBlock x:Name="TransferStatus" Text="CSV transfers meeting text only. Exported files are unencrypted." Style="{StaticResource Hint}" Margin="8,0,8,8" AutomationProperties.LiveSetting="Polite"/>
                <DockPanel Margin="8,0,8,8">
                    <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="_Clear search" Margin="8,0,0,0" Click="ClearSearch_Click" IsEnabled="False"/>
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="Search meetings" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search a phrase in titles, summaries, notes, actions and transcripts. Escape clears; Down selects a result."/>
                </DockPanel>
                <TextBlock Text="Find a phrase in titles, summaries, notes, actions or transcripts. Down selects a result; Enter opens it." Style="{StaticResource Hint}" Margin="8,0,8,8"/>
                <TextBlock x:Name="HistoryStatus" Text="Loading saved meetings…" Style="{StaticResource Hint}" Margin="8" AutomationProperties.LiveSetting="Polite"/>
                <ListBox x:Name="MeetingList" Background="Transparent" BorderThickness="0" MaxHeight="420"
                         AutomationProperties.Name="Meeting history results" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="MeetingList_DoubleClick" PreviewKeyDown="MeetingList_PreviewKeyDown" SelectionChanged="MeetingList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,12,0,4"/></DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Meeting.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding Meeting.StartedUtc, Converter={StaticResource LocalStartTime}}"/>
                                    <TextBlock Text="{Binding ProcessingNotice}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProcessingNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{Binding Meeting, Converter={StaticResource MeetingDuration}, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Meeting.Transcript.Count, Mode=OneWay, StringFormat='{}{0} lines'}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="OpenMeetingButton" Content="Open selected meeting" Click="OpenMeeting_Click" HorizontalAlignment="Left" Margin="8" IsEnabled="False"/>
            </StackPanel>
        </Border>
        <TextBlock Text="Your audio, transcripts and notes stay on this PC." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
    </StackPanel>
    </ScrollViewer>
</Window>
