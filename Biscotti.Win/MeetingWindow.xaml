<Window x:Class="Biscotti.Win.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Biscotti.Win"
        Title="{Binding Title}" Height="760" Width="940" MinWidth="660" MinHeight="480" Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <local:SecondsToTimeConverter x:Key="SecToTime"/>
        <local:LocalStartTimeConverter x:Key="LocalStartTime"/>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox x:Name="TitleBox" FontSize="28" FontFamily="Georgia"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Meeting title"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock x:Name="LiveStatus" Text="Recording · transcript updates as speech is recognized"
                       Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,8,0,8"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Style="{StaticResource Hint}">
                <Run Text="{Binding StartedUtc, Converter={StaticResource LocalStartTime}}"/>
            </TextBlock>
            <WrapPanel x:Name="TransferControls" Margin="0,12,0,0">
                <Button x:Name="CopyMarkdownButton" Content="Copy Markdown…" Click="CopyMarkdown_Click" Margin="0,0,8,4"/>
                <Button x:Name="ExportMarkdownButton" Content="Export Markdown…" Click="ExportMarkdown_Click" Margin="0,0,8,4"/>
            </WrapPanel>
            <TextBlock x:Name="TransferStatus" Text="Copy and export include current edits as unencrypted text, without audio." Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <TabControl x:Name="ReviewTabs" Grid.Row="1" Margin="0,20,0,0">
            <TabItem x:Name="TranscriptTab" Header="Transcript">
                <Grid>
                <TextBlock x:Name="TranscriptEmptyText" Style="{StaticResource Hint}" Margin="12" Text="No transcript is available for this meeting yet." Visibility="Collapsed"/>
                <ScrollViewer x:Name="TranscriptScroller">
                    <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding Transcript}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource WashBrush}" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6">
                                            <Run Text="{Binding Speaker, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding StartSeconds, Converter={StaticResource SecToTime}, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="24"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="SummaryTab" Header="Summary">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SummaryEmptyText" Style="{StaticResource Hint}" Margin="8,0,8,12" Text="No summary yet. Summaries need Ollama running locally with your configured model." Visibility="Collapsed"/>
                <TextBox x:Name="SummaryBox" Grid.Row="1" Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Meeting summary"
                             AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                             BorderThickness="0" FontSize="15"
                             VerticalScrollBarVisibility="Auto"/>
                    <GroupBox x:Name="ActionItemsGroup" Grid.Row="2" Header="Action items" Margin="0,12,0,0" Padding="12" MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActionItemsList" ItemsSource="{Binding ActionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="NotesTab" Header="Notes">
                <Grid x:Name="NotesGrid" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="LiveNoteEditor" Visibility="Collapsed">
                        <TextBlock Text="Add a note at the current recording time" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <TextBox x:Name="LiveNoteInput" MinHeight="64" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="New timestamped note"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <Button x:Name="AddLiveNoteButton" Content="Add timestamped note" Padding="14,6"
                                    Click="AddLiveNote_Click"/>
                            <TextBlock x:Name="LiveNoteStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="TimestampedNotesScroller" Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TimestampedNotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource WashBrush}" CornerRadius="4">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding StartSeconds, Converter={StaticResource SecToTime}, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Text, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <GroupBox Grid.Row="2" Header="Your Markdown notes" Margin="0,12,0,0" Padding="8">
                    <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Meeting notes in Markdown" ToolTip="Write your notes in Markdown. Changes are kept when you choose Save."
                             AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                             BorderThickness="0" FontSize="15"
                             VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem x:Name="AudioTab" Header="Audio">
                <StackPanel Margin="16">
                    <TextBlock Text="Listen to either side of the meeting. One channel plays at a time."
                               Style="{StaticResource Hint}" Margin="0,0,0,20"/>
                    <GroupBox Header="Microphone" Padding="12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MicPlayButton" Content="Play microphone" Padding="14,6" Click="MicPlay_Click"/>
                            <Button x:Name="MicStopButton" Content="Stop" Padding="14,6" Margin="8,0,0,0"
                                    IsEnabled="False" Click="MicStop_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="System audio" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SysPlayButton" Content="Play system audio" Padding="14,6" Click="SysPlay_Click"/>
                            <Button x:Name="SysStopButton" Content="Stop" Padding="14,6" Margin="8,0,0,0"
                                    IsEnabled="False" Click="SysStop_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock x:Name="AudioStatus" Text="" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DeleteButton" Content="Delete meeting" Foreground="{DynamicResource DangerBrush}" Click="Delete_Click"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
