<Window x:Class="Biscotti.Win.MeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Biscotti.Win"
        Title="{Binding Title}" Height="640" Width="820" Background="#FAF9F6">
    <Window.Resources>
        <local:SecondsToTimeConverter x:Key="SecToTime"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox x:Name="TitleBox" FontSize="22" FontWeight="SemiBold"
                     Background="Transparent" BorderThickness="0"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Foreground="#668">
                <Run Text="{Binding StartedUtc, StringFormat='{}{0:yyyy-MM-dd  HH:mm}'}"/>
            </TextBlock>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Transcript">
                <ScrollViewer>
                    <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding Transcript}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Foreground="#885" FontSize="11">
                                            <Run Text="{Binding Speaker, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding StartSeconds, Converter={StaticResource SecToTime}, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Summary">
                <ScrollViewer>
                    <TextBox x:Name="SummaryBox" Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                             BorderThickness="0" FontSize="14"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="My notes">
                <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                         BorderThickness="0" FontSize="14"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Delete meeting" Padding="14,6" Background="#FDECEA" BorderThickness="0" Click="Delete_Click"/>
            <Button Content="Save" Padding="14,6" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
