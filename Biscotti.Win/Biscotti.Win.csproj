<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\biscotti.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Assets\biscotti.png" />
    <Resource Include="Assets\biscotti.ico" />
    <Resource Include="Assets\biscotti.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biscotti.Core\Biscotti.Core.csproj" />
  </ItemGroup>

</Project>
