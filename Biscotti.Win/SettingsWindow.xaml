<Window x:Class="Biscotti.Win.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biscotti Win settings" Width="600" Height="600" MinWidth="480" MinHeight="420"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Make Biscotti work for your meetings. Preferences stay on this PC." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="RECORDING SHORTCUT" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Start or stop recording from anywhere." Style="{StaticResource Hint}"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" x:Name="CaptureButton" Content="Record shortcut" Click="CaptureButton_Click"/>
                        <TextBox x:Name="ShortcutBox" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Recording shortcut"/>
                    </DockPanel>
                    <TextBlock x:Name="MessageText" Margin="0,12,0,0" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <TextBlock Text="CUSTOM VOCABULARY" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Label Content="_Names and technical terms" Target="{Binding ElementName=VocabularyBox}" Padding="0,0,0,8"/>
                    <TextBlock Text="Separate terms with commas or new lines to help Whisper recognize them." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                    <TextBox x:Name="VocabularyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="96" MaxHeight="160" AutomationProperties.Name="Custom vocabulary"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" MinWidth="84" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Save" MinWidth="84" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
