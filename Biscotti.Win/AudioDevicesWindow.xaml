<Window x:Class="Biscotti.Win.AudioDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/biscotti.ico"
        Title="Audio devices" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#FAF9F6">
    <StackPanel Margin="24">
        <TextBlock Text="Audio devices" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                   Text="Choose what Biscotti records. Device selection is available when no recording or processing is in progress."/>
        <StackPanel x:Name="DeviceChoices">
            <Label Target="{Binding ElementName=MicrophoneBox}" Content="_Microphone" Padding="0,0,0,6"/>
            <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" MinHeight="32"
                      AutomationProperties.Name="Microphone"/>
            <Label Target="{Binding ElementName=OutputBox}" Content="_Output (speakers or headphones)" Padding="0,14,0,6"/>
            <ComboBox x:Name="OutputBox" DisplayMemberPath="Name" MinHeight="32"
                      AutomationProperties.Name="Output device"/>
        </StackPanel>
        <TextBlock x:Name="DeviceMessage" Margin="0,14,0,0" Foreground="#555"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Padding="16,8" Click="Refresh_Click"/>
            <Button x:Name="SaveButton" Content="Save devices" Padding="16,8" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Padding="16,8" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
